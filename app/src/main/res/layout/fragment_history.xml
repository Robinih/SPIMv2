<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipToPadding="false"
    android:clipChildren="false"
    tools:context=".fragments.HistoryFragment">

    <!-- Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title with accent bar -->
        <View
            android:id="@+id/accent_bar"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:background="@color/primary_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_history_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_history_title" />

        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_history"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/accent_bar"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sync"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sync"
            android:textAllCaps="false"
            android:textColor="@color/primary_green"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/primary_green"
            app:layout_constraintBottom_toBottomOf="@+id/tv_history_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_history_title" />

        <TextView
            android:id="@+id/tv_history_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_subtitle"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintStart_toStartOf="@id/tv_history_title"
            app:layout_constraintTop_toBottomOf="@id/tv_history_title" />

        <!-- Sync Status/Progress -->
        <ProgressBar
            android:id="@+id/sync_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:visibility="gone"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_sync"
            app:layout_constraintEnd_toStartOf="@+id/btn_sync"
            app:layout_constraintTop_toTopOf="@+id/btn_sync" />

        <!-- Time-Based Filter Controls -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_group_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btn_filter_all_time"
            app:layout_constraintTop_toBottomOf="@id/tv_history_subtitle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filter_all_time"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:text="All"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filter_today"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:text="Today"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filter_week"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:text="Week"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filter_month"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:text="Month"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/divider" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- History List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_history" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_icon_circle_green"
                android:alpha="0.3" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_history"
                app:tint="@color/primary_green" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_empty_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start scanning to build your history"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_clear_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@drawable/ic_delete"
        app:backgroundTint="@color/error_red"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Selection Mode Action Bar (hidden until long-press) -->
    <LinearLayout
        android:id="@+id/selection_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@color/primary_green"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_cancel_selection"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_clear"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel selection"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="0 selected"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_selected"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="@color/white"
            app:backgroundTint="@color/error_red"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
