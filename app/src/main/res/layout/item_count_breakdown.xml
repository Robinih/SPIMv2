<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <!-- Left Accent Bar -->
        <View
            android:id="@+id/v_color_indicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/primary_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/tv_species_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="Rice Bug" />
        </LinearLayout>

        <!-- Count Badge -->
        <TextView
            android:id="@+id/tv_species_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/confidence_badge_bg"
            android:backgroundTint="@color/card_green_tint"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/primary_green_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="xA 5" />
            
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/text_hint" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
